<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0">System User Setup</h4>

            <div class="page-title-right">
                <a role="button" class="btn btn-sm w-sm btn-primary" href="/sys/user/create">Add New</a>
                <a role="button" class="btn btn-sm w-sm btn-primary">Search</a>
                <a role="button" class="btn btn-sm w-sm btn-primary">Help</a>
            </div>

        </div>
    </div>
</div>

<div class="row font-size-12">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
        
                <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap">

                    <thead>
                        <tr>
                            <th class="py-1 col-4">Sugnon Name</th>
                            <th class="py-1 col-6">Full Name</th>
                            <th class="py-1 col-1 text-center">Status</th>
                            <th class="py-1 col-1 text-center">Action</th>
                        </tr>
                    </thead>
        
                    <tbody>
                        <% if (modules.length > 0) { %>
                            <% modules.forEach(mod => { %>
                                <tr>
                                    <td class="py-1">Tiger Nixon</td>
                                    <td class="py-1">Tiger Nixon</td>
                                    <td class="py-1 text-center">Tiger Nixon</td>
                                    <td class="py-1 text-center">
                                        <div class="dropdown dropstart">
                                            <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                <i class="fas fa-tools"></i>
                                            </a>
                                            <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                                <a class="dropdown-item py-1" href="/sys/user/view/<%= mod.app_module_id %>">View</a>
                                                <a class="dropdown-item py-1" href="/sys/user/edit/<%= mod.app_module_id %>">Edit</a>
                                                <div class="dropdown-divider my-0 border-2"></div>
                                                <a class="dropdown-item py-1" href="#">Authorize</a>
                                                <div class="dropdown-divider my-0 border-2"></div>
                                                <a class="dropdown-item py-1" href="#">Reset</a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>

                </table>
        
            </div>
        </div>
    </div>
</div>
