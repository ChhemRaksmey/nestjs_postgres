<% pageStyle = '' %>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0">AML - Customer Detected Roles Alert</h4>
            <div class="page-title-right">
                <a role="button" class="btn btn-sm w-sm btn-primary">Search</a>
                <a role="button" class="btn btn-sm w-sm btn-primary">Help</a>
            </div>
        </div>
    </div>
</div>



<div class="card card-body">

    <table class="table text-muted font-size-11">
        <thead>
            <th class="col-6"></th>
            <th class="col-6"></th>
        </thead>
        <tbody>

            <tr>
                <td class="p-0 pb-2">
                    <span class="h5 text-muted">
                        <b>Customer Accounts</b>
                    </span>
                </td>
            </tr>
            <tr>
                <td class="p-0">
                    <div class="row">
                        <div class="col-md-7 row">
            
                            <div class="m-0 mb-1 col-md-5"><b>Branch Name</b></div>
                            <div class="m-0 mb-1 col-md-7">: Main Branch</div>
                            
                            <div class="m-0 mb-1 col-md-5"><b>Account Product</b></div>
                            <div class="m-0 mb-1 col-md-7">: Individual Saving Account (USD)</div>
                            
                            <div class="m-0 mb-1 col-md-5"><b>Opened Date</b></div>
                            <div class="m-0 mb-1 col-md-7">: 2026 July 28</div>

                            <div class="m-0 mb-1 col-md-5"><b>Closed Date</b></div>
                            <div class="m-0 mb-1 col-md-7">: </div>
                            
                            <div class="m-0 mb-1 col-md-5"><b>Work Balances</b></div>
                            <div class="m-0 mb-1 col-md-7">: 12,345,678.90 (USD)</div>

                        </div>
                        <div class="col-md-5 row">

                            <div class="m-0 mb-1 col-md-12"><b>Account Holders</b></div>
                            
                            <div class="m-0 mb-1 col-md-5"><b>Role</b></div>
                            <div class="m-0 mb-1 col-md-7"><b>Customer Name</b></div>

                            <div class="m-0 mb-1 col-md-5">Owner</div>
                            <div class="m-0 mb-1 col-md-7">xxxxxx xxxxxxxxx</div>
                            
                            <div class="m-0 mb-1 col-md-5">Joiner</div>
                            <div class="m-0 mb-1 col-md-7">xxxxxx xxxxxxxxx</div>
                            
                            <div class="m-0 mb-1 col-md-5">Joiner</div>
                            <div class="m-0 mb-1 col-md-7">xxxxxx xxxxxxxxx</div>
                            
                        </div>
                    </div>
                </td>
            </tr>

            
            <tr>
                <td class="p-0 pb-2">
                    <span class="h5 text-muted">
                        <b>Customer Activities</b>
                    </span>
                </td>
            </tr>
            <tr>
                <td class="p-0">

                    <div class="row mb-3">
            
                        <div class="m-0 mb-1 col-md-2"><b>Date Time</b></div>
                        <div class="m-0 mb-1 col-md-10">: 2026 July 28 15:37</div>

                        <div class="m-0 mb-1 col-md-2"><b>Transaction Id</b></div>
                        <div class="m-0 mb-1 col-md-2">: XXXXXXXX</div>

                        <div class="m-0 mb-1 col-md-2"><b>Action Type</b></div>
                        <div class="m-0 mb-1 col-md-2">: Cash Deposit</div>
                        
                        <div class="m-0 mb-1 col-md-2"><b>Amount (FCY)</b></div>
                        <div class="m-0 mb-1 col-md-2">: 12,345,678.90 (KHR)</div>
                        <div class="m-0 mb-1 col-md-2"><b>Amount (LCY)</b></div>
                        <div class="m-0 mb-1 col-md-2">: 12,345,678.90 (USD)</div>


<!--                         
                        <div class="m-0 mb-1 col-md-2"><b>Action Acct</b></div>
                        <div class="m-0 mb-1 col-md-5">: XXXXXXXXXXXXXXXXXXXXXXXX</div>
                        <div class="m-0 mb-1 col-md-2"><b>Benefit Acct</b></div>
                        <div class="m-0 mb-1 col-md-5">: XXXXXXXXXXXXXXXXXXXXXXXX</div>
                        
                        <div class="m-0 mb-1 col-md-2"><b>Remark</b></div>
                        <div class="m-0 mb-1 col-md-11">: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</div> -->

                    </div>

                </td>
            </tr>


        </tbody>
    </table>

</div>



