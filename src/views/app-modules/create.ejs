<form action="/app-modules/create" method="post" enctype="multipart/form-data">

    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">System Application Module</h4>

                <div class="page-title-right">
                    <button type="submit" class="btn btn-sm w-sm btn-primary">Submit</button>
                    <a role="button" class="btn btn-sm w-sm btn-primary" href="/app-modules">Cancel</a>
                    <a role="button" class="btn btn-sm w-sm btn-primary">Help</a>
                </div>

            </div>
        </div>
    </div>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card font-size-12">
        <div class="card-body">
            
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link py-1 active" data-bs-toggle="tab" href="#navtabs-detail" role="tab">
                        <span class="d-none d-sm-block">Detail</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1" data-bs-toggle="tab" href="#navtabs-audit" role="tab">
                        <span class="d-none d-sm-block">Audit</span>
                    </a>
                </li>
            </ul>

            <div class="tab-content p-3 text-muted">

                <div role="tabpanel" class="tab-pane active" id="navtabs-detail">
                    <div class="row">
        
                        <div class="col-md-4">
                            <div class="mb-2">
                                <label class="form-label mb-0">Module Id (auto generate later)</label>
                                <input type="text" class="form-control form-control-sm" name="app_module_id" value="" />
                            </div>
                        </div>
        
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="form-label mb-0">Full Name</label>
                                <input type="text" class="form-control form-control-sm" name="full_name" value="" />
                            </div>
                        </div>
                        
                    </div>
                </div>

                <div role="tabpanel" class="tab-pane" id="navtabs-audit"></div>

            </div>
            
        </div>
    </div>

</form>