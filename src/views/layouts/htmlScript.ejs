<!-- Datatable init js -->
<script>
    $(document).ready(function () {

        $(".picker-dropdown").select2();

        $('#datatable').DataTable({
            ordering: !1,
            lengthChange: !1,
            language: {
                paginate: {
                    first: '<i class="fas fa-angle-double-left"></i>',
                    last: '<i class="fas fa-angle-double-right"></i>',
                    next: '<i class="fas fa-angle-right"></i>',
                    previous: '<i class="fas fa-angle-left"></i>'
                }
            },
        });

        $('#db-table-search-result').DataTable({
            ordering: !1,
            lengthChange: !1,
            searching: !1,
            language: {
                paginate: {
                    first: '<i class="fas fa-angle-double-left"></i>',
                    last: '<i class="fas fa-angle-double-right"></i>',
                    next: '<i class="fas fa-angle-right"></i>',
                    previous: '<i class="fas fa-angle-left"></i>'
                }
            },
        });
        
    });
</script>

