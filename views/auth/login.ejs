<!doctype html>
<html lang="en">

<head>

    <%- include('../layouts/htmlStyle') %>

</head>

<body class="authentication-bg">

    <div class="account-pages my-5 pt-sm-5">
        <div class="container">

            <div class="row align-items-center justify-content-center">
                <div class="col-md-8 col-lg-6 col-xl-5">
                    <div class="card">
                        <div class="card-body p-4">

                            <div class="text-center mt-2">
                                <h5 class="text-primary">Welcome Back !</h5>
                                <p class="text-muted"><b>M.E.S</b> - Backend System</p>
                            </div>

                            <div class="p-2 mt-4">
                                <form action="/login" method="POST">

                                    <% if (error) { %>
                                        <div class="mb-3">
                                            <div class="alert alert-danger"><%= error %></div>
                                        </div>
                                    <% } %>

                                    <div class="mb-3">
                                        <label class="form-label mb-0 font-size-12">Username</label>
                                        <input type="text" class="form-control" name="signon_name" placeholder="Enter username" value="adminstrattor" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label mb-0 font-size-12">Password</label>
                                        <input type="password" class="form-control" name="password" placeholder="Enter password" value="12341234" />
                                    </div>
                                    
                                    <div class="dropdown-divider my-0 border-4"></div>

                                    <div class="mt-3 text-end">
                                        <input type="submit" class="form-control btn btn-primary" role="button" />
                                    </div>

                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <%- include('../layouts/htmlScript') %>

</body>

</html>