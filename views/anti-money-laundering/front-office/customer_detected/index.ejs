
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0">AML - Customer Detected Roles Alert</h4>
            <div class="page-title-right">
                <a role="button" class="btn btn-sm w-sm btn-primary">Search</a>
                <a role="button" class="btn btn-sm w-sm btn-primary">Help</a>
            </div>
        </div>
    </div>
</div>

<div class="card card-body mb-3">
    <div class="row">
        
        <div class="col-md-2">
            <label class="form-label font-size-12 mb-0">Detected Date</label>
            <input type="text" class="form-control form-control-sm" value="2026-01-01" />
        </div>
        
        <div class="col-md-2">
            <label class="form-label font-size-12 mb-0">Sansactions Type</label>
            <select class="picker-dropdown form-select form-select-sm">
                <option value="ALL" selected>All Sansactions Type</option>
                <option value="Consumer">Consumer</option>
                <option value="Commercial">Commercial</option>
            </select>
        </div>
        
        <div class="col-md-3">
            <label class="form-label font-size-12 mb-0">Branches</label>
            <select class="picker-dropdown form-select form-select-sm">
                <option value="ALL" selected>All Branches</option>
                <option value="Branch1">Branch 1</option>
                <option value="Branch2">Branch 2</option>
                <option value="Branch3">Branch 3</option>
            </select>
        </div>
        
        <div class="col-md-5">
            <label class="form-label font-size-12 mb-0">Detection Roles</label>
            <select class="picker-dropdown form-select form-select-sm" multiple="multiple" data-placeholder="Choose ...">
                <option value="ALL" selected>All Roles</option>
                <option value="AML-001">AML-001</option>
                <option value="AML-002">AML-002</option>
                <option value="AML-003">AML-003</option>
                <option value="AML-004">AML-004</option>
                <option value="AML-005">AML-005</option>
            </select>
        </div>

    </div>
</div>

<div class="row font-size-13">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
        
                <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap">

                    <thead>
                        <tr>
                            <th class="py-1 col-1 text-center">CID</th>
                            <th class="py-1 col-1 text-center">Branch</th>
                            <th class="py-1 col-4">Customer Name</th>
                            <th class="py-1 col-5">Detected Roles</th>
                            <th class="py-1 col-1 text-center">Action</th>
                        </tr>
                    </thead>
        
                    <tbody>

                        <% for(var i=1; i <= 15; i++) { %>
                            <tr>
                                <td class="py-1 text-center">Consumer Name <%= i %></td>
                                <td class="py-1 text-center"></td>
                                <td class="py-1"></td>
                                <td class="py-1">90%</td>
                                <td class="py-1 text-center">
                                    <a role="button" class="text-muted fas fa-ellipsis-h" data-bs-toggle="modal" aria-haspopup="true" aria-expanded="false" data-bs-target="#popup-view"></a>
                                </td>
                            </tr>
                        <% } %>

                    </tbody>

                </table>
        
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="popup-view" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">

            <div class="modal-header pb-2">
                <h6 class="modal-title">Customer Detected Roles Alert Overview</h6>
                <div>
                    <button type="button" class="btn btn-sm w-sm btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>

            <div class="modal-body">
                
                <div class="card card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    <div class="carousel-item active" data-bs-interval="10000">
                                        <img src="/images/small/img-1.jpg" class="d-block w-100" alt="...">
                                    </div>
                                    <div class="carousel-item" data-bs-interval="2000">
                                        <img src="/images/small/img-2.jpg" class="d-block w-100" alt="...">
                                    </div>
                                    <div class="carousel-item">
                                        <img src="/images/small/img-3.jpg" class="d-block w-100" alt="...">
                                    </div>
                                </div>
                                <a class="carousel-control-prev" href="#carouselExampleInterval" role="button" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </a>
                                <a class="carousel-control-next" href="#carouselExampleInterval" role="button" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <th class="p-0 pt-1">Customer ID:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                    </tr>
                                    <tr>
                                        <th class="p-0 pt-1">Family Name:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Document Type:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Address Province:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                    </tr>
                                    <tr>
                                        <th class="p-0 pt-1">Giving Name:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Document No:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Address District:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                    </tr>
                                    <tr>
                                        <th class="p-0 pt-1">Gender:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Document Issue By:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Address Commune:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                    </tr>
                                    <tr>
                                        <th class="p-0 pt-1">Date Of Birth:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Document Date Issue:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Address Village:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                    </tr>
                                    <tr>
                                        <th class="p-0 pt-1">Place Of Brith:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Document Date Expiry:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <th class="p-0 pt-1">Street Name/No:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                    </tr>
                                    <tr>
                                        <th class="p-0 pt-1">Nationality:</th>
                                        <td class="p-0 pt-1">xxxxxxxxxxxxx</td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                        <td class="p-0 pt-1"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="accordion" id="accordionExample">

                    <% for(var i=1; i <= 20; i++) { %>
                        <div class="accordion-item">
                            <h6 class="accordion-header">
                                <a class="accordion-button py-2 font-size-12" data-bs-target="#collapse-view-ofac-sdn-<%= i %>" role="button" data-bs-toggle="collapse" aria-expanded="true">
                                    <b>AML-000<%= i %> | ........</b>
                                </a>
                            </h6>
                            <div class="accordion-collapse collapse show" id="collapse-view-ofac-sdn-<%= i %>">
                                <div class="accordion-body">

                                    <p class="mb-0">life of transaction or releated info</p>

                                </div>
                            </div>
                        </div>
                    <% } %>

                </div>

            </div>

        </div>
    </div>
</div>
