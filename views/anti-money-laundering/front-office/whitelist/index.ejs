<% pageStyle = '' %>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0">AML - White-List Customers</h4>
            <div class="page-title-right">
                <a role="button" class="btn btn-sm w-sm btn-primary">Search</a>
                <a role="button" class="btn btn-sm w-sm btn-primary">Help</a>
            </div>
        </div>
    </div>
</div>

<div class="card card-body mb-3">
    <div class="row">
        
        <div class="col-md-3 mb-2">
            <label class="form-label font-size-12 mb-0">Customer Name</label>
            <input type="text" class="form-control form-control-sm" placeholder="cid / legacy id / customer name" />
        </div>
        
        <div class="col-md-3 mb-2">
            <label class="form-label font-size-12 mb-0">Document Id</label>
            <input type="text" class="form-control form-control-sm" placeholder="document number" />
        </div>
        
        <div class="col-md-3 mb-2">
            <label class="form-label font-size-12 mb-0">Branch</label>
            <select class="picker-dropdown form-select form-select-sm" multiple="multiple" data-placeholder="Choose ...">
                <option value="ALL" selected>All Branches</option>
                <option value="Branch 1">Branch 1</option>
                <option value="Branch 2">Branch 2</option>
                <option value="Branch 3">Branch 3</option>
                <option value="Branch 4">Branch 4</option>
            </select>
        </div>

    </div>
</div>

<div class="row font-size-12">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
        
                <table id="dt-main-listing" class="table table-striped table-bordered dt-responsive nowrap">

                    <thead>
                        <tr>
                            <th class="py-1 col-1">CID</th>
                            <th class="py-1 col-4">Customer Name</th>
                            <th class="py-1 col-3">Exception Date</th>
                            <th class="py-1 col-3">Release Date</th>
                            <th class="py-1 col-1 text-center">Action</th>
                        </tr>
                    </thead>
        
                    <tbody>

                        <% for(var i=1; i <= 15; i++) { %>
                            <tr>
                                <td class="py-1">Consumer Name <%= i %></td>
                                <td class="py-1"></td>
                                <td class="py-1"></td>
                                <td class="py-1"></td>
                                <td class="py-1 text-center">
                                    <a role="button" class="text-muted fas fa-ellipsis-h" data-bs-toggle="modal" aria-haspopup="true" aria-expanded="false" data-bs-target="#popup-view"></a>
                                </td>
                            </tr>
                        <% } %>

                    </tbody>

                </table>
        
            </div>
        </div>
    </div>
</div>

