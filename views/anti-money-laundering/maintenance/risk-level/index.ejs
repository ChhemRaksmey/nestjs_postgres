
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0">AML - Risk Level</h4>
            <div class="page-title-right">
                <a role="button" class="btn btn-sm w-sm btn-primary">Help</a>
            </div>
        </div>
    </div>
</div>

<div class="row font-size-12">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
        
                <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap">

                    <thead>
                        <tr>
                            <th class="py-1 col-11">Customer Type</th>
                            <th class="py-1 col-1 text-center">Action</th>
                        </tr>
                    </thead>
        
                    <tbody>

                        <tr>
                            <td class="py-1">Consumer</td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-tools"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Edit</a>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td class="py-1">Commercial</td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-tools"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Edit</a>
                                    </div>
                                </div>
                            </td>
                        </tr>

                    </tbody>

                </table>
        
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="popup-form-view" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header pb-2">
                <h5 class="modal-title">View Risk Level</h5>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-12 mb-2">
                        <label class="form-label mb-0">Customer Type</label>
                        <input type="text" class="form-control form-control-sm" disabled readonly value="" />
                    </div>
                </div>

                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white py-1 col-6">Risk Level</th>
                            <th class="bg-primary text-white py-1 col-4 text-center">Risk Color</th>
                            <th class="bg-primary text-white py-1 col-2 text-center">Max Score %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-1">High</td>
                            <td class="py-1 text-center" style="color: #bb0202;">#bb0202</td>
                            <td class="py-1 text-center">100</td>
                        </tr>
                        <tr>
                            <td class="py-1">medium</td>
                            <td class="py-1 text-center" style="color: #e2c800;">#e2c800</td>
                            <td class="py-1 text-center">80</td>
                        </tr>
                        <tr>
                            <td class="py-1">Low</td>
                            <td class="py-1 text-center" style="color: #19d5ac;">#19d5ac</td>
                            <td class="py-1 text-center">40</td>
                        </tr>
                    </tbody>
                </table>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm w-sm btn-primary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="popup-form-edit" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header pb-2">
                <h5 class="modal-title">Edit Risk Level</h5>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-12 mb-2">
                        <label class="form-label mb-0">Customer Type</label>
                        <input type="text" class="form-control form-control-sm" disabled readonly value="" />
                    </div>
                </div>

                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th class="py-1 col-6">Risk Level</th>
                            <th class="py-1 col-4">Risk Color</th>
                            <th class="py-1 col-2">Max Score %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 form-control form-control-sm" name="risk_name_1" value="High" /></td>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 text-center form-control form-control-sm" name="risk_color_1" id="picker-color1" value="#bb0202" />
                            </td>
                            <td class="py-1 px-1">
                                <input type="number" class="px-1 text-center form-control form-control-sm" name="risk_max_score_1" value="100" />
                            </td>
                        </tr>
                        <tr>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 form-control form-control-sm" name="risk_name_2" value="medium" /></td>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 text-center form-control form-control-sm" name="risk_color_2" id="picker-color2" value="#e2c800" />
                            </td>
                            <td class="py-1 px-1">
                                <input type="number" class="px-1 text-center form-control form-control-sm" name="risk_max_score_2" value="80" />
                            </td>
                        </tr>
                        <tr>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 form-control form-control-sm" name="risk_name_3" value="Low" /></td>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 text-center form-control form-control-sm" name="risk_color_3" id="picker-color3" value="#19d5ac" />
                            </td>
                            <td class="py-1 px-1">
                                <input type="number" class="px-1 text-center form-control form-control-sm" name="risk_max_score_3" value="40" />
                            </td>
                        </tr>
                        <tr>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 form-control form-control-sm" name="risk_name_4" value="" /></td>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 text-center form-control form-control-sm" name="risk_color_4" id="picker-color4" value="" />
                            </td>
                            <td class="py-1 px-1">
                                <input type="number" class="px-1 text-center form-control form-control-sm" name="risk_max_score_4" value="" />
                            </td>
                        </tr>
                        <tr>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 form-control form-control-sm" name="risk_name_5" value="" /></td>
                            <td class="py-1 px-1">
                                <input type="text" class="px-1 text-center form-control form-control-sm" name="risk_color_5" id="picker-color5" value="" />
                            </td>
                            <td class="py-1 px-1">
                                <input type="number" class="px-1 text-center form-control form-control-sm" name="risk_max_score_5" value="" />
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm w-sm btn-primary">Submit</button>
                <button type="button" class="btn btn-sm w-sm btn-primary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
