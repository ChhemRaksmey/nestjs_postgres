<% pageStyle = '' %>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0">AML - Risk Level</h4>
        </div>
    </div>
</div>

<div class="row font-size-12">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
        
                <table id="dt-main-listing" class="table table-striped table-bordered dt-responsive nowrap">

                    <thead>
                        <tr>
                            <th class="py-1 text-uppercase col-11"><b>Customer Type</b></th>
                            <th class="py-1 text-uppercase col-1 text-center"><b>Action</b></th>
                        </tr>
                    </thead>
        
                    <tbody>

                        <tr>
                            <td class="py-1">Consumer</td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" href="/aml/maintenance/risk/level/edit/Consumer">Edit</a>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td class="py-1">Commercial</td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" href="/aml/maintenance/risk/level/edit/Commercial">Edit</a>
                                    </div>
                                </div>
                            </td>
                        </tr>

                    </tbody>

                </table>
        
            </div>
        </div>
    </div>
</div>

<div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" style="display: none;" id="popup-form-view">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header pb-2">
                <h5 class="modal-title">View Risk Level</h5>
            </div>

            <div class="modal-body">

                <div class="row">
                    <div class="col-md-12 mb-2">
                        <label class="form-label mb-0">Customer Type</label>
                        <input type="text" class="form-control form-control-sm" disabled readonly value="" />
                    </div>
                </div>

                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th class="bg-primary text-white py-1 col-6">Risk Level</th>
                            <th class="bg-primary text-white py-1 col-4 text-center">Risk Color</th>
                            <th class="bg-primary text-white py-1 col-2 text-center">Max Score %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-1">High</td>
                            <td class="py-1 text-center" style="color: #bb0202;">#bb0202</td>
                            <td class="py-1 text-center">100</td>
                        </tr>
                        <tr>
                            <td class="py-1">medium</td>
                            <td class="py-1 text-center" style="color: #e2c800;">#e2c800</td>
                            <td class="py-1 text-center">80</td>
                        </tr>
                        <tr>
                            <td class="py-1">Low</td>
                            <td class="py-1 text-center" style="color: #19d5ac;">#19d5ac</td>
                            <td class="py-1 text-center">40</td>
                        </tr>
                    </tbody>
                </table>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm w-sm btn-primary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" style="display: none;" id="popup-form-edit">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header pb-2">
                <h5 class="modal-title">Edit Risk Level</h5>
            </div>

            <div class="modal-body">
                <div class="outer-repeater">
                    <div data-repeater-list="outer-group" class="outer">
                        <div data-repeater-item class="outer">
                            <div class="inner-repeater">
                                <div class="inner row">

                                    <div class="col-md-12 mb-2">
                                        <label class="form-label mb-1">Customer Type</label>
                                        <input type="text" class="form-control form-control-sm" disabled readonly value="" />
                                    </div>

                                    <div class="col-md-12 mb-2">
                                        <table class="table mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="p-1 col-5">Risk Level</th>
                                                    <th class="p-1 col-3">Risk Color</th>
                                                    <th class="p-1 col-3">Max Score</th>
                                                    <th class="p-1 col-1 text-center"><a href="javascript: void(0);" class="px-1 text-primary" data-repeater-create><i class="fas fa-plus"></i></a></th>
                                                </tr>
                                            </thead>
                                            <tbody data-repeater-list="inner-group">
                                                <tr data-repeater-item class="inner">
                                                    <td class="p-1"><input type="text" class="form-control form-control-sm" /></td>
                                                    <td class="p-1"><input type="text" class="form-control form-control-sm" /></td>
                                                    <td class="p-1"><input type="text" class="form-control form-control-sm" /></td>
                                                    <td class="p-1 text-center">
                                                        <a href="javascript: void(0);" class="px-1 text-danger" data-repeater-delete><i class="fas fa-minus"></i></a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm w-sm btn-primary">Submit</button>
                <button type="button" class="btn btn-sm w-sm btn-primary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<% pageScripts = `<script>
    $(document).ready(function () {
        
    });
</script>`; %>
