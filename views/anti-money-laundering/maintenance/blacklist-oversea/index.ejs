<% pageStyle = '' %>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <h4 class="mb-0">Blacklist Oversea</h4>
            <div>
                <button class="btn btn-sm btn-primary w-sm">Start Extract</button>
                <button class="btn btn-sm btn-primary w-sm">Help</button>
            </div>
        </div>
    </div>
</div>

<div class="row font-size-12">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
        
                <table id="dt-main-listing" class="table table-striped table-bordered dt-responsive nowrap">

                    <thead>
                        <tr>
                            <th class="py-1 text-uppercase col-3"><b>SHORT NAME</b></th>
                            <th class="py-1 text-uppercase col-5"><b>FULL NAME</b></th>
                            <th class="py-1 text-uppercase col-2 text-center"><b>LAST EXTRACT DATE</b></th>
                            <th class="py-1 text-uppercase col-1 text-center"><b>STATUS</b></th>
                            <th class="py-1 text-uppercase col-1 text-center"><b>ACTION</b></th>
                        </tr>
                    </thead>
        
                    <tbody>
                        <tr>
                            <td class="py-1">EU</td>
                            <td class="py-1">European Union</td>
                            <td class="py-1 text-center">2026-07-29 00:01</td>
                            <td class="py-1 text-center"><span class="badge bg-success">Completed</span></td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Edit</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Run Extract</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-1">UN</td>
                            <td class="py-1">United Nations</td>
                            <td class="py-1 text-center">2026-07-29 00:01</td>
                            <td class="py-1 text-center"><span class="badge bg-success">Completed</span></td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Edit</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Run Extract</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-1">OFAC-Consolidated</td>
                            <td class="py-1">Office of Foreign Assets Control - Consolidated</td>
                            <td class="py-1 text-center">2026-07-29 00:01</td>
                            <td class="py-1 text-center"><span class="badge bg-success">Completed</span></td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Edit</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Run Extract</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-1">OFAC-SDN</td>
                            <td class="py-1">Office of Foreign Assets Control - SDN</td>
                            <td class="py-1 text-center">2026-07-29 00:01</td>
                            <td class="py-1 text-center"><span class="badge bg-success">Completed</span></td>
                            <td class="py-1 text-center">
                                <div class="dropdown dropstart">
                                    <a role="button" class="" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-ellipsis-h"></i>
                                    </a>
                                    <div class="dropdown-menu font-size-12" style="inset: unset !important;">
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-view">View</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Edit</a>
                                        <a class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#popup-form-edit">Run Extract</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>

                </table>
        
            </div>
        </div>
    </div>
</div>

<% pageScripts = `
    <script>
        $(document).ready(function () {

            $(".picker-dropdown").select2();

            $('#dt-main-listing').DataTable({
                ordering: !1,
                lengthChange: !1,
                searching: !1,
                language: {
                    paginate: {
                        first: '<i class="fas fa-angle-double-left"></i>',
                        last: '<i class="fas fa-angle-double-right"></i>',
                        next: '<i class="fas fa-angle-right"></i>',
                        previous: '<i class="fas fa-angle-left"></i>'
                    }
                },
            });

        });
    </script>
` %>